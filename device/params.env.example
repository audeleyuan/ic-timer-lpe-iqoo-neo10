# Runtime addresses for the CURRENT boot, produced by tools/vote.py from the
# phase-1 capture.  KASLR changes them on every reboot: if the phone rebooted
# after collect.sh, these are stale -- redo phase 1.
#
# FUNCS_ADDR     = __tracepoint_sys_exit + 0x40 + slide
#                  (vr.ko disarm; leave empty if /proc/modules has no "vr")
# SELINUX_STATE  = selinux_state + slide.  The exploit shifts it to state-7
#                  itself, so only `enforcing` is cleared and `initialized`
#                  survives.  Leave empty when the target policy already has a
#                  permissive domain to drop into (e.g. u:r:ksu:s0).
# INIT_USER_NS   = init_user_ns + slide
#                  (real user namespace: makes the fake cred's capabilities
#                   count in init_user_ns, which ksud late-load needs)
# CTXMAP         = context to scan for the drop: u:r:ksu:s0 on a device that
#                  has had KernelSU loaded, u:r:shell:s0 on stock + permissive
# PKG            = manager package for the handoff, empty = auto-detect
FUNCS_ADDR=0x0
SELINUX_STATE=0x0
INIT_USER_NS=0x0
CTXMAP=u:r:shell:s0
PKG=me.weishu.kernelsu
ATTEMPTS=16
